# Shared PIN distributed by host (required)
CERT_PORTAL_PIN=123456

# Secret used to sign session cookies (required in production)
CERT_PORTAL_AUTH_SECRET=replace-with-long-random-secret

# Optional: path to certificate output directory (relative to /web by default)
CERTIFICATE_OUTPUT_DIR=../output

# Optional: path to manifest generated by Python CLI
CERTIFICATE_INDEX_PATH=../output/index.json

