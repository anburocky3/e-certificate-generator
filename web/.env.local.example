# Shared PIN distributed by host (required)
CERT_PORTAL_PIN=123456

# Host/admin-only PIN for dashboard routes (/host/login, /host/status)
# If omitted, it falls back to CERT_PORTAL_PIN.
CERT_HOST_PORTAL_PIN=654321

# Secret used to sign session cookies (required in production)
CERT_PORTAL_AUTH_SECRET=replace-with-long-random-secret

# Optional: path to certificate output directory (relative to /web by default).
# For Vercel/web-only deploys, generate files into `web/public/certificates`.
CERTIFICATE_OUTPUT_DIR=public/certificates

# Optional: path to manifest generated by Python CLI
CERTIFICATE_INDEX_PATH=public/certificates/index.json

# Optional: hard deadline for downloads (ISO format, UTC recommended)
# Example: 2026-12-31T23:59:59Z
CERT_DOWNLOAD_EXPIRES_AT=

